{
  "name": "ai-customer-service-training",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "knowledge:check": "tsx scripts/knowledge.ts check",
    "knowledge:publish": "tsx scripts/knowledge.ts publish",
    "knowledge:publish:db": "tsx scripts/publish-knowledge-to-db.ts",
    "quiz:build": "tsx scripts/quiz.ts build",
    "quiz:publish:db": "tsx scripts/publish-quiz-to-db.ts",
    "scenario:publish:db": "tsx scripts/publish-scenarios-to-db.ts",
    "production:verify:data": "tsx scripts/verify-production-data.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "SCENARIO_AI_MODE=mock playwright test",
    "test:e2e:scenario": "SCENARIO_AI_MODE=mock pnpm exec playwright test tests/e2e/scenario-smoke.spec.ts --grep mock",
    "test:e2e:live": "E2E_BASE_URL=https://ai-customer-service-training.vercel.app RUN_LIVE_AI_SMOKE=true pnpm exec playwright test tests/e2e/scenario-smoke.spec.ts --grep live",
    "check:company-stack": "bash tests/scripts/company-stack-scripts.sh && cd backend && .venv/bin/python -m pytest -q && cd .. && npm --prefix frontend test && npm --prefix frontend run build",
    "test:e2e:company-stack": "env -u NO_COLOR playwright test -c playwright.company-stack.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
