# Copy to /etc/ai-customer-service-training/backend.env and restrict to 0600.
APP_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8005
FRONTEND_ORIGIN=https://training.example.com
DATABASE_URL=mysql+pymysql://training_user:change-me@127.0.0.1:3306/training?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
FEISHU_APP_CLIENT_ID=replace-me
FEISHU_APP_CLIENT_SECRET=replace-me
FEISHU_REDIRECT_URI=https://training.example.com/api/v1/auth/feishu/callback
SCENARIO_AI_MODE=ark
ARK_BASE_URL=https://ark.example.com/api/v3
ARK_API_KEY=replace-me
ARK_MODEL=replace-me
ARK_TIMEOUT_SECONDS=15
