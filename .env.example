# Neon PostgreSQL connection string. Keep the real value in .env.local.
DATABASE_URL=

# Required in production. Generate at least 32 random characters.
AUTH_SECRET=

# Local-only login fallback. Production validation rejects `true`.
LOCAL_TEST_AUTH_ENABLED=false

# Used only by `pnpm db:seed`; passwords must be supplied locally.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_NAME=培训管理员
SEED_ADMIN_PASSWORD=
SEED_LEARNER_EMAIL=learner@example.test
SEED_LEARNER_NAME=客服学员
SEED_LEARNER_PASSWORD=

# AI 模拟情景对话模式：mock（默认，确定性演示）| real（真实 LLM）
SCENARIO_AI_MODE=mock

# 真实模式必需：从 Vercel 函数区域可达的 OpenAI 兼容 API 配置
# baseURL 使用公司批准的 OpenAI 兼容入口；SDK 会自动拼接对应的 completions 路径
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-approved-model

# 如果改用 Vercel AI Gateway，可显式设为 true；该链路可能要求项目账户具备额度。
# VERCEL_OIDC_TOKEN 由 Vercel 运行时自动注入，不要手动保存。
AI_GATEWAY_ENABLED=
AI_GATEWAY_MODEL=bytedance/seed-1.8
